Program 1: NumPy Operations

import numpy as np

arr = np.array([10,20,30,40,50,12,33,89,23,65])

print("array: ", arr)

sorted_arr = np.sort(arr)
print(sorted_arr)

print("sum: ", np.sum(arr))
print("accessing elements: ", arr[2])
print("accessing elements: ", arr[0:4])
print("accessing elements: ", arr[-1])
print("minimum: ", np.min(arr))
print("maximum: ", np.max(arr))

import numpy as nm

x = nm.arange(10)
print("elements are: ", x)

x[[2,5,8]] = 99
print("after adding: ", x)

print("addition of elements: ", x[3]+x[8])

