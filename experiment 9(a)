Program 2: Pandas Operations

import pandas as pd

data = {
    "name": ["a", "b", "c", "d"],
    "marks": [80, 90, 85, 70],
    "age": [20, 20, 19, 19],
    "course": ["bca", "bca", "bba", "btech"],
    "place": ["e", "f", "g", "h"]
}

df = pd.DataFrame(data)

print(df)
print("head: \n", df.head)
print("tail: \n", df.tail)

print("\n info:")
df.info()

print("\n describe: \n", df.describe())

print("\n sorted: \n", df.sort_values("marks"))

